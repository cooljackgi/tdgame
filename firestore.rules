
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isMember(gameId) {
      return request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.members;
    }
    
    match /games/{gameId} {
      allow read: if request.auth != null; // Allow any authenticated user to read game data
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update, delete: if request.auth.uid in resource.data.members;
      
      // Log sub-collections
      match /webrtc_logs/{logId} {
          allow create: if request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.members; // Only members can write logs for their own game
          allow read: if request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.members; // Only members can read logs
      }
      
      match /game_logs/{logId} {
          allow create: if request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.members;
          allow read: if request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.members;
      }
    }
    
    match /scores/{scoreId} {
      allow read: if true; // Anyone can read the scoreboard
      allow create: if request.auth != null && request.auth.uid == request.resource.data.playerUid; // Users can only create scores for themselves
      allow update, delete: if false; // Nobody can edit or delete scores
    }
  }
}
