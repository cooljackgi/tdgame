
{
  "functions": {
    "source": "app/src/functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" install",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": [
    {
      "target": "nextn",
      "source": ".",
      "frameworksBackend": {
        "region": "us-central1"
      }
    }
  ],
  "emulators": {
    "hosting": {
      "port": 9002
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8081
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true
    }
  }
}
