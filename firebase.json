
{
  "hosting": [
    {
      "target": "nextn",
      "source": ".",
      "apphosting": {
        "region": "us-central1"
      }
    }
  ],
  "emulators": {
    "hosting": {
      "port": 9002,
      "rewrites": [
        {
          "source": "/ws",
          "function": "ws-relay"
        }
      ]
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8081
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true
    }
  }
}

